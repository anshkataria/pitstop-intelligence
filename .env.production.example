POSTGRES_DB=pitstop
POSTGRES_USER=pitstop_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
ML_INTERNAL_TOKEN=replace-with-a-separate-random-private-service-token
PUBLIC_ORIGIN=https://pitstop.example.com
PUBLIC_HOST=pitstop.example.com
GHCR_REPOSITORY=owner/pitstop-intelligence
IMAGE_TAG=replace-with-a-release-commit-sha
GRAFANA_ADMIN_USER=pitstop-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
# Leave unset to fetch every F1 season from 1950 through the current year.
SEASONS_TO_FETCH=
INGESTION_CRON=0 3 * * 1
INGESTION_TIMEZONE=UTC
INGESTION_RUN_ON_STARTUP=false
INGESTION_ALERT_WEBHOOK_URL=
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TOKEN=
LIVE_POLL_SECONDS=20
LIVE_LOOKBACK_MINUTES=10
LIVE_WORKER_ENABLED=true
