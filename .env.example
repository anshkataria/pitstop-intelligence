POSTGRES_DB=pitstop
POSTGRES_USER=pitstop
POSTGRES_PASSWORD=pitstop_dev_password
REDIS_PASSWORD=redis_dev_password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ML_INTERNAL_TOKEN=replace-with-a-random-private-service-token
CORS_ALLOWED_ORIGINS=http://localhost:4200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Leave unset to fetch every F1 season from 1950 through the current year.
SEASONS_TO_FETCH=
INGESTION_CRON=0 3 * * 1
INGESTION_TIMEZONE=Australia/Brisbane
INGESTION_RUN_ON_STARTUP=false
# Optional generic JSON webhook for failure and recovery notifications.
INGESTION_ALERT_WEBHOOK_URL=
OPENF1_BASE_URL=https://api.openf1.org/v1
# Sponsor token is required for during-session OpenF1 live access; replay/recent data works without it.
OPENF1_TOKEN=
LIVE_POLL_SECONDS=20
LIVE_LOOKBACK_MINUTES=10
LIVE_WORKER_ENABLED=true
